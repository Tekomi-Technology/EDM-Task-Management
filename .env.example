# Copy to .env and adjust. Values below match infra/docker-compose.yml for local development only.

# API
API_PORT=3000
DATABASE_URL=postgres://edm:edm_dev_password@localhost:55432/edm
REDIS_URL=redis://localhost:56379
KEYCLOAK_URL=http://localhost:58080
KEYCLOAK_REALM=edm
# Client the API uses to manage accounts (dev secret only; set a real one in production)
KEYCLOAK_ADMIN_CLIENT_ID=edm-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=edm-api-admin-dev-secret
# Give new tickets to the least busy field staff on duty automatically
AUTO_ASSIGN=true
# SMS: "log" only prints messages (development). "http" sends through any HTTP gateway described below,
# e.g. try it locally with `pnpm sms-gateway` and SMS_HTTP_URL=http://localhost:59090/send
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
# json or form; the body may use {{to}} (+258…), {{to_digits}} (258…), {{from}} and {{text}}
SMS_HTTP_CONTENT_TYPE=json
SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","text":"{{text}}"}
SMS_HTTP_HEADERS={}
SMS_HTTP_SUCCESS_TEXT=
SMS_SENDER_ID=EDM
# Push to the EDM Field app through Expo ("log" only prints them)
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
# push_or_sms: app push, SMS if no app or the push fails · push_and_sms: both · sms_only
STAFF_ALERTS=push_or_sms
# Survey results and connection updates go to the Sales system here (e.g. `pnpm sales webhook` locally)
SALES_WEBHOOK_URL=
SALES_WEBHOOK_SECRET=sales-webhook-dev-secret
# S3-compatible storage (SeaweedFS locally, MinIO or any S3 in production)
S3_ENDPOINT=http://localhost:59000
# Address phones and browsers use to download/upload photos (use your LAN IP when testing the app on a phone)
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=edm
S3_SECRET_KEY=edm_dev_password
S3_BUCKET=edm-attachments
CORS_ORIGINS=http://localhost:5173

# Web (Vite)
VITE_API_URL=http://localhost:3000
VITE_KEYCLOAK_URL=http://localhost:58080
VITE_KEYCLOAK_REALM=edm
VITE_KEYCLOAK_CLIENT_ID=edm-web

# Call Center simulator
CALLCENTER_CLIENT_ID=call-center-system
CALLCENTER_CLIENT_SECRET=call-center-dev-secret

# Address of a point marked on the map (Nominatim). The public OpenStreetMap server is for light use only;
# point it at EDM's own Nominatim for heavy use. Empty turns the feature off.
GEOCODER_URL=https://nominatim.openstreetmap.org
