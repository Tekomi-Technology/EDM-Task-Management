# Filled in when the container starts (nginx image: /etc/nginx/templates): ${API_PUBLIC_URL}, ${KEYCLOAK_PUBLIC_URL},
# ${S3_PUBLIC_ENDPOINT} and ${MAP_TILE_ORIGIN} are the only places the page may talk to or load images from.
server {
  listen 80;
  root /usr/share/nginx/html;
  server_tokens off;

  # Only this site's own scripts run; data goes only to the API and the sign-in server; nobody may frame the page.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: ${MAP_TILE_ORIGIN} ${S3_PUBLIC_ENDPOINT}; connect-src 'self' ${API_PUBLIC_URL} ${KEYCLOAK_PUBLIC_URL}; frame-src ${KEYCLOAK_PUBLIC_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_PUBLIC_URL}; object-src 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    # add_header in a location replaces the server ones, so repeat the security headers.
    add_header Content-Security-Policy "default-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  # Single-page app: every route is served by index.html.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: ${MAP_TILE_ORIGIN} ${S3_PUBLIC_ENDPOINT}; connect-src 'self' ${API_PUBLIC_URL} ${KEYCLOAK_PUBLIC_URL}; frame-src ${KEYCLOAK_PUBLIC_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_PUBLIC_URL}; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
  }
}
