# Copy to infra/.env.prod (never commit the real file) and replace every value.
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PUBLIC_URL=https://sso.example.co.mz
WEB_PUBLIC_URL=https://tasks.example.co.mz
# Production realm: no sample users or dev clients. Secrets below are written into it on first import.
KEYCLOAK_REALM_FILE=./keycloak/realm-edm.prod.json
# Long random values (e.g. `openssl rand -hex 32`); give each one only to the team running that system.
CALL_CENTER_CLIENT_SECRET=change-me
SALES_CLIENT_SECRET=change-me
# Lets the API create, block and reset accounts in Keycloak
API_ADMIN_CLIENT_SECRET=change-me
# The network management system sends alarms with this client secret
NMS_CLIENT_SECRET=change-me
# EDM's stock management system sends receipts and reads consumption with this client secret
STOCK_CLIENT_SECRET=change-me
S3_ENDPOINT=https://s3.example.co.mz
S3_PUBLIC_ENDPOINT=https://s3.example.co.mz
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=edm-attachments
API_IMAGE=edm-api:latest
WEB_IMAGE=edm-web:latest

# SMS gateway (any HTTP provider; see .env.example in the repository root for the placeholders)
SMS_PROVIDER=http
SMS_HTTP_URL=https://sms-provider.example/api/send
SMS_HTTP_CONTENT_TYPE=json
SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","text":"{{text}}"}
SMS_HTTP_HEADERS={"Authorization":"Bearer change-me"}
SMS_SENDER_ID=EDM
# Push to the EDM Field app
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
STAFF_ALERTS=push_or_sms
# Survey results and connection updates are posted here (signed with the secret)
SALES_WEBHOOK_URL=
SALES_WEBHOOK_SECRET=change-me
# Public address of the API, if not the same as WEB_PUBLIC_URL (used in the web page's Content-Security-Policy).
# API_PUBLIC_URL=https://api.example.co.mz
# API description at /api/docs: off in production unless set to true.
# API_DOCS=false
# How long the Connected systems log and the alerts under the bell are kept (days).
# INTEGRATION_LOG_DAYS=90
# NOTIFICATION_DAYS=90
