# Single VPS at https://edm.tekomi.vn (infra/DEPLOY-VPS.md). Copy to infra/.env.prod (never commit the real file)
# and replace every change-me with a long random value from `openssl rand -hex 32` (hex only: some values end up
# inside URLs and JSON).
WEB_PUBLIC_URL=https://edm.tekomi.vn
KEYCLOAK_PUBLIC_URL=https://edm.tekomi.vn/auth
# The gateway listens on 127.0.0.1:GATEWAY_PORT; the server's nginx proxies https://edm.tekomi.vn to it.
GATEWAY_PORT=8090

POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Production realm: no sample users or dev clients. Secrets below are written into it on first import.
KEYCLOAK_REALM_FILE=./keycloak/realm-edm.prod.json
# Give each one only to the team running that system.
CALL_CENTER_CLIENT_SECRET=change-me
SALES_CLIENT_SECRET=change-me
# Lets the API create, block and reset accounts in Keycloak
API_ADMIN_CLIENT_SECRET=change-me
# The network management system sends alarms with this client secret
NMS_CLIENT_SECRET=change-me
# EDM's stock management system sends receipts and reads consumption with this client secret
STOCK_CLIENT_SECRET=change-me

# Photo storage: the storage container in this stack. Phones and browsers reach it through the public address.
S3_ENDPOINT=http://storage:8333
S3_PUBLIC_ENDPOINT=https://edm.tekomi.vn
S3_ACCESS_KEY=edm
S3_SECRET_KEY=change-me
S3_BUCKET=edm-attachments
# infra/scripts/backup.sh runs outside the stack, so it reaches the storage through the public address too.
BACKUP_S3_ENDPOINT=https://edm.tekomi.vn

# SMS: "log" only writes messages to the API log. Switch to "http" once a gateway is chosen (see .env.example).
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_CONTENT_TYPE=json
SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","text":"{{text}}"}
SMS_HTTP_HEADERS={}
SMS_SENDER_ID=EDM
# Push to the EDM Field app
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
STAFF_ALERTS=push_or_sms
# Survey results and connection updates are posted here (signed with the secret)
SALES_WEBHOOK_URL=
SALES_WEBHOOK_SECRET=change-me
# API description at /api/docs: off in production unless set to true.
# API_DOCS=false
