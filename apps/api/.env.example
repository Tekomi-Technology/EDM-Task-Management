# Server settings for the backend (docker-compose.yml in this folder). Copy to .env next to it (never commit the
# real file), chmod 600, and replace every change-me with `openssl rand -hex 32` (hex only: some values end up
# inside URLs and JSON). Development does not use this file: see .env.example in the repository root.

# The public address of the site (web, API and photos are all under it).
WEB_PUBLIC_URL=https://edm.tekomi.vn
# Ports on 127.0.0.1 the server's nginx sends /api and the photo addresses to (see DEPLOY.md).
API_HOST_PORT=8091
STORAGE_HOST_PORT=8093

POSTGRES_PASSWORD=change-me
# Signs the sign-in tokens; changing it signs everyone out. The other systems' API keys (Call Center, Sales, NMS,
# stock) are made by an administrator in the web app: Settings → API keys.
AUTH_SECRET=change-me

# Photo storage (the storage container).
S3_ACCESS_KEY=edm
S3_SECRET_KEY=change-me
S3_BUCKET=edm-attachments
# scripts/backup.sh runs outside the containers, so it reaches the storage through the public address.
BACKUP_S3_ENDPOINT=https://edm.tekomi.vn

# SMS: "log" only writes messages to the API log. Switch to "http" once a gateway is chosen (see the root
# .env.example for the SMS_HTTP_* placeholders).
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_CONTENT_TYPE=json
SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","text":"{{text}}"}
SMS_HTTP_HEADERS={}
SMS_SENDER_ID=EDM
# Push to the EDM Field app
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
STAFF_ALERTS=push_or_sms
# Survey results and connection updates are posted here (signed with the secret)
SALES_WEBHOOK_URL=
SALES_WEBHOOK_SECRET=change-me
# Address of a point marked on the map; empty turns it off.
GEOCODER_URL=https://nominatim.openstreetmap.org
# API description at /api/docs: off in production unless set to true.
# API_DOCS=false
