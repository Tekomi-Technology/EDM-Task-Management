# Server settings for the web app (docker-compose.yml in this folder). Copy to .env next to it.
# Development does not use this file: see .env.example in the repository root.

# The public address of the site (the API and photos are under it too).
WEB_PUBLIC_URL=https://edm.tekomi.vn
# Port on 127.0.0.1 the server's nginx sends the pages to (see DEPLOY.md).
WEB_HOST_PORT=8090
